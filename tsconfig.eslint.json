{
  "extends": "./.nuxt/tsconfig.server.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.vue",
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    ".nuxt/**/*.d.ts"
  ],
  "exclude": ["node_modules", "convex/_generated"]
}
