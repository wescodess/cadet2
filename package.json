{
  "name": "cadet2",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build && node scripts/quality/build-output.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:components": "vitest run --maxWorkers=2",
    "test:legacy-access": "node --test --test-concurrency=1 tests/security/legacy-*.test.mjs tests/security/obsolete-specs.test.mjs tests/security/retired-router.test.mjs tests/security/sign-out.test.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:all": "playwright test --project=chromium --project=api",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "prepare": "node scripts/quality/install-hooks.mjs",
    "typecheck": "node scripts/quality/types.mjs",
    "lint": "node scripts/quality/lint.mjs",
    "format:check": "node scripts/quality/format.mjs",
    "secrets:check": "node scripts/quality/secrets.mjs",
    "secrets:all": "node scripts/quality/secrets.mjs --all-branches",
    "dependencies:check": "node scripts/quality/dependencies.mjs",
    "test:policy": "node scripts/quality/test-policy.mjs",
    "security:admin": "node scripts/security/run-boundaries.mjs",
    "verify": "exec node scripts/quality/verify.mjs",
    "boundaries:check": "node scripts/quality/boundaries.mjs",
    "dead-code:check": "node scripts/quality/dead-code.mjs",
    "duplication:check": "node scripts/quality/duplication.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.4.9",
    "@better-auth/utils": "0.3.0",
    "@convex-dev/better-auth": "0.10.11",
    "@convex-vue/core": "0.0.4",
    "@electric-sql/pglite": "^0.3.15",
    "@internationalized/date": "3.12.4",
    "@nuxthub/core": "^0.10.6",
    "@onmax/nuxt-better-auth": "0.0.2-alpha.29",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/vue": "1.8.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.2.1",
    "better-auth": "1.4.9",
    "better-call": "1.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.575.0",
    "nuxt": "^4.3.1",
    "nuxt-convex": "^0.0.6",
    "reka-ui": "^2.8.2",
    "tailwind-merge": "^3.5.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.28",
    "vue-input-otp": "^0.3.2",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@seontechnologies/playwright-utils": "^3.14.0",
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "dependency-cruiser": "18.8.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-vue": "10.12.1",
    "jscpd": "5.4.3",
    "jsdom": "^28.1.0",
    "knip": "6.47.0",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "shadcn-nuxt": "^2.4.3",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.0.18",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "@prisma/config>effect": "3.22.5"
    }
  }
