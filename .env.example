# Required for production builds; generate a unique value with openssl rand -hex 32.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
CONVEX_URL=https://your-deployment.convex.cloud
NUXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Interim Nuxt-hosted token issuer. The Convex deployment must use the same
# fixed Nuxt origin as CADET_AUTH_ISSUER. Component auth replaces this under #53.
CONVEX_SITE_URL=http://127.0.0.1:3000
CADET_AUTH_ISSUER=http://127.0.0.1:3000
